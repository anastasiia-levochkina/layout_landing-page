var menuBtn = document.querySelector(".menu-btn");
var menu = document.querySelector(".menu");
var closeBtn = document.querySelector(".menu__close");
var menuNav = document.querySelector(".menu__nav");
var pageBody = document.body;
var openMenu = function() {
    menu.classList.add("active");
    pageBody.classList.add("menu-open");
};
var closeMenu = function() {
    menu.classList.remove("active");
    pageBody.classList.remove("menu-open");
};
menuBtn.onclick = function() {
    openMenu();
};
closeBtn.onclick = function() {
    closeMenu();
};
document.addEventListener("click", function(evt) {
    var clickInsideMenu = menu.contains(evt.target);
    var clickOnMenuButton = menuBtn.contains(evt.target);
    if (menu.classList.contains("active") && !clickInsideMenu && !clickOnMenuButton) closeMenu();
});
menuNav.addEventListener("click", function(evt) {
    if (evt.target.closest("a")) closeMenu();
});
var contactForm = document.querySelector(".contact__form");
var sendBtn = document.querySelector(".btn-send");
var successMessage = document.querySelector(".contact__success");
if (contactForm && sendBtn && successMessage) contactForm.addEventListener("submit", function(evt) {
    evt.preventDefault();
    sendBtn.classList.add("btn-send--success");
    successMessage.classList.add("contact__success--visible");
    contactForm.reset();
});
var phoneLinks = document.querySelectorAll('a[href^="tel:"]');
var emailLinks = document.querySelectorAll('a[href^="mailto:"]');
var toastTimeoutId;
var showToast = function(message) {
    var callToast = document.querySelector(".call-toast");
    if (!callToast) {
        callToast = document.createElement("div");
        callToast.className = "call-toast";
        pageBody.append(callToast);
    }
    callToast.textContent = message;
    callToast.classList.add("call-toast--visible");
    window.clearTimeout(toastTimeoutId);
    toastTimeoutId = window.setTimeout(function() {
        callToast.classList.remove("call-toast--visible");
    }, 2200);
};
phoneLinks.forEach(function(phoneLink) {
    phoneLink.addEventListener("click", function(evt) {
        evt.preventDefault();
        showToast("Nothing is calling you");
    });
});
emailLinks.forEach(function(emailLink) {
    emailLink.addEventListener("click", function(evt) {
        evt.preventDefault();
        showToast("Send a message to Nothing");
    });
});

